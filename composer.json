{
  "name": "writeshh/yarp",
  "description": "Yet Another Repository Pattern, my take on Repository Design Pattern.",
  "keywords": [
    "writeshh",
    "yarp",
    "laravel",
    "repository",
    "repository-pattern",
    "service",
    "design",
    "pattern",
    "eloquent"
  ],
  "homepage": "https://github.com/writeshh/yarp",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Ritesh Shrestha",
      "email": "shrestha.ritesh@hotmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/filesystem": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
  },
  "autoload": {
    "psr-4": {
      "Writeshh\\Yarp\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Writeshh\\Yarp\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "test-unit": "vendor/bin/phpunit --testsuite=Unit",
    "test-feature": "vendor/bin/phpunit --testsuite=Feature",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "format": "vendor/bin/pint",
    "format-check": "vendor/bin/pint --test",
    "audit": "@composer audit",
    "check": [
      "@format-check",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "2.0.x-dev"
    },
    "laravel": {
      "providers": [
        "Writeshh\\Yarp\\YarpServiceProvider"
      ],
      "aliases": {
        "Yarp": "Writeshh\\Yarp\\Facades\\Yarp"
      }
    }
  }
}
