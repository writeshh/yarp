{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "concat_space": {
            "spacing": "none"
        },
        "not_operator_with_successor_space": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "phpdoc_align": false,
        "single_class_element_per_statement": false
    },
    "exclude": [
        "vendor"
    ]
}
